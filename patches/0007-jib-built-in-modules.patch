+
+// Jib: TizCat's modules (TizCat Services, and later JibWallet and others)
+// are built in like Yuzal: each folder in <exe dir>\modules that holds a
+// manifest is loaded as a component extension. run.ps1 copies them there from
+// tizcat\modules on every start, so a module changes, or a new one arrives,
+// without TizCat being recompiled. The key in each manifest fixes its ID.
+void ComponentLoader::AddJibModules() {
+  base::FilePath exe_dir;
+  if (!base::PathService::Get(base::DIR_EXE, &exe_dir)) {
+    return;
+  }
+  GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](const base::FilePath& modules) {
+            std::vector<std::pair<base::FilePath, base::DictValue>> found;
+            base::FileEnumerator folders(modules, /*recursive=*/false,
+                                         base::FileEnumerator::DIRECTORIES);
+            for (base::FilePath root = folders.Next(); !root.empty();
+                 root = folders.Next()) {
+              std::string error;
+              std::optional<base::DictValue> manifest =
+                  file_util::LoadManifest(root, &error);
+              if (!manifest) {
+                LOG(WARNING) << "Jib: module not loaded from " << root << ": "
+                             << error;
+                continue;
+              }
+              found.emplace_back(root, std::move(*manifest));
+            }
+            return found;
+          },
+          exe_dir.AppendASCII("modules")),
+      base::BindOnce(&ComponentLoader::FinishAddJibModules,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void ComponentLoader::FinishAddJibModules(
+    std::vector<std::pair<base::FilePath, base::DictValue>> modules) {
+  for (auto& [root, manifest] : modules) {
+    Add(std::move(manifest), root, /*skip_allowlist=*/true);
+  }
+}

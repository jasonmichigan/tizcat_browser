+// Jib: whether `extension` is one of TizCat's modules, built in from
+// <exe dir>\modules by ComponentLoader::AddJibModules (patch 0007).
+bool IsJibModule(const extensions::Extension& extension) {
+  if (extension.location() != extensions::mojom::ManifestLocation::kComponent) {
+    return false;
+  }
+  base::FilePath exe_dir;
+  return base::PathService::Get(base::DIR_EXE, &exe_dir) &&
+         base::FilePath::CompareEqualIgnoreCase(
+             extension.path().DirName().value(),
+             exe_dir.AppendASCII("modules").value());
+}

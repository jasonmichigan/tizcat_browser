+// sql::Database tags must be on a list generated from the metrics files, and
+// adding one would rebuild every file that opens a database. The tag only
+// names metrics, which TizCat does not send, so the Firefox importer's is
+// reused.
+inline constexpr sql::Database::Tag kDatabaseTag{"FirefoxImporter"};
+
+// Chromium keeps most times as microseconds since 1601 (Windows' epoch).
+base::Time FromChromiumTime(int64_t microseconds) {
+  if (microseconds <= 0) {
+    return base::Time();
+  }
+  return base::Time::FromDeltaSinceWindowsEpoch(
+      base::Microseconds(microseconds));
+}
+
+bool CanImportURL(const GURL& url) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS();
+}
+
+// Undoes Windows' per-user encryption (DPAPI). Only this Windows user can.
+std::optional<std::string> Unprotect(std::string_view data) {
+  DATA_BLOB in = {static_cast<DWORD>(data.size()),
+                  reinterpret_cast<BYTE*>(const_cast<char*>(data.data()))};
+  DATA_BLOB out = {};
+  if (!CryptUnprotectData(&in, nullptr, nullptr, nullptr, nullptr,
+                          CRYPTPROTECT_UI_FORBIDDEN, &out)) {
+    return std::nullopt;
+  }
+  std::string result(reinterpret_cast<const char*>(out.pbData), out.cbData);
+  SecureZeroMemory(out.pbData, out.cbData);
+  LocalFree(out.pbData);
+  return result;
+}
+
+// The key a Chromium browser encrypts saved passwords with. It is kept in
+// the browser's Local State, itself encrypted with DPAPI.
+std::optional<std::string> LoadPasswordKey(const base::FilePath& local_state) {
+  std::string json;
+  if (!base::ReadFileToString(local_state, &json)) {
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> state =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!state) {
+    return std::nullopt;
+  }
+  const std::string* encoded =
+      state->FindStringByDottedPath("os_crypt.encrypted_key");
+  std::string wrapped;
+  if (!encoded || !base::Base64Decode(*encoded, &wrapped) ||
+      !wrapped.starts_with("DPAPI")) {
+    return std::nullopt;
+  }
+  std::optional<std::string> key =
+      Unprotect(std::string_view(wrapped).substr(5));
+  if (!key || key->size() != 32) {
+    return std::nullopt;
+  }
+  return key;
+}
+
+// A saved password as Chromium stores it:
+//  - "v10" (or "v11"): AES-256-GCM with the Local State key; a 12-byte nonce
+//    follows the prefix and the 16-byte tag ends it.
+//  - "v20": Google Chrome's app-bound encryption, which only Chrome itself
+//    can undo. Those passwords are left out.
+//  - anything else: an older value, encrypted with DPAPI directly.
+std::optional<std::u16string> DecryptPassword(
+    std::string_view value,
+    const std::optional<std::string>& key) {
+  if (value.empty()) {
+    return std::u16string();
+  }
+  if (value.starts_with("v10") || value.starts_with("v11")) {
+    if (!key || value.size() < 3 + 12 + 16) {
+      return std::nullopt;
+    }
+    std::optional<std::vector<uint8_t>> plain = crypto::aead::Open(
+        crypto::aead::AES_256_GCM, base::as_byte_span(*key),
+        base::as_byte_span(value.substr(3 + 12)),
+        base::as_byte_span(value.substr(3, 12)),
+        base::span<const uint8_t>());
+    if (!plain) {
+      return std::nullopt;
+    }
+    std::u16string password =
+        base::UTF8ToUTF16(std::string(plain->begin(), plain->end()));
+    std::ranges::fill(*plain, 0);
+    return password;
+  }
+  if (value.starts_with("v2")) {
+    return std::nullopt;
+  }
+  std::optional<std::string> plain = Unprotect(value);
+  if (!plain) {
+    return std::nullopt;
+  }
+  std::u16string password = base::UTF8ToUTF16(*plain);
+  std::ranges::fill(*plain, '\0');
+  return password;
+}
+
+// Adds the bookmarks under `node` (a folder in a Bookmarks file) to `out`.
+// Folders with something in them are given by their entries' `path`; an
+// empty folder is an entry of its own.
+void AddBookmarks(const base::DictValue& node,
+                  bool in_toolbar,
+                  std::vector<std::u16string>* path,
+                  std::set<std::tuple<std::vector<std::u16string>,
+                                      std::u16string,
+                                      std::string>>* seen,
+                  std::vector<user_data_importer::ImportedBookmarkEntry>* out) {
+  const base::ListValue* children = node.FindList("children");
+  if (!children) {
+    return;
+  }
+  for (const base::Value& child_value : *children) {
+    const base::DictValue* child = child_value.GetIfDict();
+    if (!child) {
+      continue;
+    }
+    const std::string* type = child->FindString("type");
+    const std::string* name = child->FindString("name");
+    const std::string* added = child->FindString("date_added");
+    int64_t added_us = 0;
+    if (added) {
+      base::StringToInt64(*added, &added_us);
+    }
+    user_data_importer::ImportedBookmarkEntry entry;
+    entry.in_toolbar = in_toolbar;
+    entry.path = *path;
+    entry.title = name ? base::UTF8ToUTF16(*name) : std::u16string();
+    // A bookmark with no date is dated now, as one added by hand would be.
+    entry.creation_time =
+        added_us > 0 ? FromChromiumTime(added_us) : base::Time::Now();
+    if (type && *type == "url") {
+      const std::string* url = child->FindString("url");
+      if (!url) {
+        continue;
+      }
+      entry.url = GURL(*url);
+      if (!entry.url.is_valid() ||
+          !seen->insert({entry.path, entry.title, entry.url.spec()}).second) {
+        continue;
+      }
+      out->push_back(std::move(entry));
+    } else if (type && *type == "folder") {
+      const base::ListValue* inside = child->FindList("children");
+      if (!inside || inside->empty()) {
+        entry.is_folder = true;
+        if (seen->insert({entry.path, entry.title, std::string()}).second) {
+          out->push_back(std::move(entry));
+        }
+        continue;
+      }
+      path->push_back(entry.title);
+      AddBookmarks(*child, in_toolbar, path, seen, out);
+      path->pop_back();
+    }
+  }
+}

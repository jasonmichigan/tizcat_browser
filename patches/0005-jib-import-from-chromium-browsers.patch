+}  // namespace
+
+ChromiumImporter::ChromiumImporter() = default;
+
+ChromiumImporter::~ChromiumImporter() = default;
+
+void ChromiumImporter::StartImport(
+    const user_data_importer::SourceProfile& source_profile,
+    uint16_t items,
+    ImporterBridge* bridge) {
+  bridge_ = bridge;
+  source_path_ = source_profile.source_path;
+  local_state_ = source_profile.app_path.Append(FILE_PATH_LITERAL("Local State"));
+  browser_name_ = source_profile.importer_name;
+
+  bridge_->NotifyStarted();
+  if (!copies_.CreateUniqueTempDir()) {
+    bridge_->NotifyEnded();
+    return;
+  }
+  // History before bookmarks, as the other importers do: a favicon is kept
+  // only for a URL that is already in history or bookmarks.
+  if ((items & user_data_importer::HISTORY) && !cancelled()) {
+    bridge_->NotifyItemStarted(user_data_importer::HISTORY);
+    ImportHistory();
+    bridge_->NotifyItemEnded(user_data_importer::HISTORY);
+  }
+  if ((items & user_data_importer::FAVORITES) && !cancelled()) {
+    bridge_->NotifyItemStarted(user_data_importer::FAVORITES);
+    ImportBookmarks();
+    bridge_->NotifyItemEnded(user_data_importer::FAVORITES);
+  }
+  if ((items & user_data_importer::PASSWORDS) && !cancelled()) {
+    bridge_->NotifyItemStarted(user_data_importer::PASSWORDS);
+    ImportPasswords();
+    bridge_->NotifyItemEnded(user_data_importer::PASSWORDS);
+  }
+  if ((items & user_data_importer::SEARCH_ENGINES) && !cancelled()) {
+    bridge_->NotifyItemStarted(user_data_importer::SEARCH_ENGINES);
+    ImportSearchEngines();
+    bridge_->NotifyItemEnded(user_data_importer::SEARCH_ENGINES);
+  }
+  if ((items & user_data_importer::AUTOFILL_FORM_DATA) && !cancelled()) {
+    bridge_->NotifyItemStarted(user_data_importer::AUTOFILL_FORM_DATA);
+    ImportAutofillFormData();
+    bridge_->NotifyItemEnded(user_data_importer::AUTOFILL_FORM_DATA);
+  }
+  bridge_->NotifyEnded();
+}
+
+base::FilePath ChromiumImporter::CopyOf(std::wstring_view name) {
+  const base::FilePath file = source_path_.Append(name);
+  const base::FilePath copy = copies_.GetPath().Append(name);
+  if (!base::PathExists(file) || !base::CopyFile(file, copy)) {
+    return base::FilePath();
+  }
+  // A database in write-ahead-log mode may keep its newest changes in
+  // "<name>-wal" beside it.
+  const base::FilePath wal(file.value() + L"-wal");
+  if (base::PathExists(wal)) {
+    base::CopyFile(wal, base::FilePath(copy.value() + L"-wal"));
+  }
+  return copy;
+}
+
+void ChromiumImporter::ImportHistory() {
+  const base::FilePath file = CopyOf(L"History");
+  if (file.empty()) {
+    return;
+  }
+  sql::Database db(kDatabaseTag);
+  if (!db.Open(file)) {
+    return;
+  }
+  sql::Statement s(db.GetUniqueStatement(
+      "SELECT url, title, visit_count, typed_count, last_visit_time, hidden "
+      "FROM urls"));
+  if (!s.is_valid()) {
+    return;
+  }
+  std::vector<user_data_importer::ImporterURLRow> rows;
+  while (s.Step() && !cancelled()) {
+    GURL url(s.ColumnStringView(0));
+    if (!CanImportURL(url)) {
+      continue;
+    }
+    // Jib: a page with no visit left has no time (Chrome keeps such entries,
+    // for example for bookmarked pages whose visits were cleared). History
+    // takes only visited pages: its check that every page has a visit time
+    // is fatal in TizCat's builds, and one such entry used to close TizCat
+    // at the end of every import, losing everything imported.
+    const base::Time last_visit = FromChromiumTime(s.ColumnInt64(4));
+    if (last_visit.is_null()) {
+      continue;
+    }
+    user_data_importer::ImporterURLRow row(url);
+    row.title = s.ColumnString16(1);
+    row.visit_count = s.ColumnInt(2);
+    row.typed_count = s.ColumnInt(3);
+    row.last_visit = last_visit;
+    row.hidden = s.ColumnInt(5) != 0;
+    rows.push_back(std::move(row));
+  }
+  if (!rows.empty() && !cancelled()) {
+    bridge_->SetHistoryItems(rows, user_data_importer::VISIT_SOURCE_IE_IMPORTED);
+  }
+}
+
+void ChromiumImporter::ImportBookmarks() {
+  std::vector<user_data_importer::ImportedBookmarkEntry> bookmarks;
+  std::set<std::tuple<std::vector<std::u16string>, std::u16string,
+                      std::string>>
+      seen;
+  // "Bookmarks" holds the bookmarks kept on this computer, and
+  // "AccountBookmarks" those kept in the signed-in account (newer versions).
+  for (const wchar_t* name : {L"Bookmarks", L"AccountBookmarks"}) {
+    std::string json;
+    if (cancelled() ||
+        !base::ReadFileToString(source_path_.Append(name), &json)) {
+      continue;
+    }
+    std::optional<base::DictValue> file =
+        base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+    const base::DictValue* roots = file ? file->FindDict("roots") : nullptr;
+    if (!roots) {
+      continue;
+    }
+    // The bookmarks bar's own name heads its entries' paths; the profile
+    // writer drops it when they go straight onto TizCat's empty bar.
+    if (const base::DictValue* bar = roots->FindDict("bookmark_bar")) {
+      const std::string* bar_name = bar->FindString("name");
+      std::vector<std::u16string> path = {
+          bar_name ? base::UTF8ToUTF16(*bar_name) : u"Bookmarks bar"};
+      AddBookmarks(*bar, true, &path, &seen, &bookmarks);
+    }
+    if (const base::DictValue* other = roots->FindDict("other")) {
+      std::vector<std::u16string> path;
+      AddBookmarks(*other, false, &path, &seen, &bookmarks);
+    }
+    if (const base::DictValue* mobile = roots->FindDict("synced")) {
+      const std::string* mobile_name = mobile->FindString("name");
+      std::vector<std::u16string> path = {
+          mobile_name ? base::UTF8ToUTF16(*mobile_name)
+                      : u"Mobile bookmarks"};
+      AddBookmarks(*mobile, false, &path, &seen, &bookmarks);
+    }
+  }
+  if (!bookmarks.empty() && !cancelled()) {
+    bridge_->AddBookmarks(bookmarks, u"Imported from " + browser_name_);
+    ImportFavicons(bookmarks);
+  }
+}
+
+// After the bookmarks: history keeps an imported icon only for a page that
+// is in history or bookmarked.
+void ChromiumImporter::ImportFavicons(
+    const std::vector<user_data_importer::ImportedBookmarkEntry>& bookmarks) {
+  const base::FilePath file = CopyOf(L"Favicons");
+  if (file.empty() || cancelled()) {
+    return;
+  }
+  sql::Database db(kDatabaseTag);
+  if (!db.Open(file)) {
+    return;
+  }
+  // Each page's plain favicon (icon_type 1, not a touch or app icon). All
+  // are made 16 pixels square below, so a 16 or 32 pixel image is taken
+  // first, then the smallest there is.
+  sql::Statement s(db.GetUniqueStatement(
+      "SELECT f.url, b.image_data FROM icon_mapping m "
+      "JOIN favicons f ON f.id = m.icon_id "
+      "JOIN favicon_bitmaps b ON b.icon_id = f.id "
+      "WHERE m.page_url = ? AND f.icon_type = 1 AND length(b.image_data) > 0 "
+      "ORDER BY CASE b.width WHEN 16 THEN 0 WHEN 32 THEN 1 ELSE 2 END, "
+      "b.width LIMIT 1"));
+  if (!s.is_valid()) {
+    return;
+  }
+  // One entry per icon, with every bookmarked page that uses it.
+  std::map<GURL, favicon_base::FaviconUsageData> icons;
+  std::set<GURL> unusable;
+  for (const user_data_importer::ImportedBookmarkEntry& bookmark : bookmarks) {
+    if (cancelled()) {
+      return;
+    }
+    if (bookmark.is_folder || !CanImportURL(bookmark.url)) {
+      continue;
+    }
+    s.Reset(true);
+    s.BindString(0, bookmark.url.spec());
+    if (!s.Step()) {
+      continue;
+    }
+    const GURL icon_url(s.ColumnStringView(0));
+    if (!icon_url.is_valid() || unusable.contains(icon_url)) {
+      continue;
+    }
+    auto it = icons.find(icon_url);
+    if (it == icons.end()) {
+      // The image is decoded and drawn again as a fresh PNG, as the other
+      // importers do, so nothing but a plain image comes across.
+      std::optional<std::vector<uint8_t>> png =
+          importer::ReencodeFavicon(base::as_byte_span(s.ColumnBlobAsVector(1)));
+      if (!png) {
+        unusable.insert(icon_url);
+        continue;
+      }
+      favicon_base::FaviconUsageData icon;
+      icon.favicon_url = icon_url;
+      icon.png_data = std::move(*png);
+      it = icons.emplace(icon_url, std::move(icon)).first;
+    }
+    it->second.urls.insert(bookmark.url);
+  }
+  favicon_base::FaviconUsageDataList list;
+  for (auto& [icon_url, icon] : icons) {
+    list.push_back(std::move(icon));
+  }
+  if (!list.empty() && !cancelled()) {
+    bridge_->SetFavicons(list);
+  }
+}
+
+void ChromiumImporter::ImportPasswords() {
+  std::optional<std::string> key = LoadPasswordKey(local_state_);
+  std::set<std::tuple<std::string, std::string, std::u16string>> seen;
+  // "Login Data" holds the passwords saved on this computer, and
+  // "Login Data For Account" those saved to the signed-in account.
+  for (const wchar_t* name : {L"Login Data", L"Login Data For Account"}) {
+    const base::FilePath file = CopyOf(name);
+    if (file.empty() || cancelled()) {
+      continue;
+    }
+    sql::Database db(kDatabaseTag);
+    if (!db.Open(file)) {
+      continue;
+    }
+    sql::Statement s(db.GetUniqueStatement(
+        "SELECT origin_url, action_url, username_element, username_value, "
+        "password_element, password_value, signon_realm, "
+        "blacklisted_by_user, scheme FROM logins"));
+    if (!s.is_valid()) {
+      continue;
+    }
+    while (s.Step() && !cancelled()) {
+      user_data_importer::ImportedPasswordForm form;
+      // 0 is a web form and 1 HTTP basic sign-in; digest and others can't
+      // be carried over.
+      const int scheme = s.ColumnInt(8);
+      if (scheme == 0) {
+        form.scheme = user_data_importer::ImportedPasswordForm::Scheme::kHtml;
+      } else if (scheme == 1) {
+        form.scheme = user_data_importer::ImportedPasswordForm::Scheme::kBasic;
+      } else {
+        continue;
+      }
+      form.url = GURL(s.ColumnStringView(0));
+      form.action = GURL(s.ColumnStringView(1));
+      form.username_element = s.ColumnString16(2);
+      form.username_value = s.ColumnString16(3);
+      form.password_element = s.ColumnString16(4);
+      form.signon_realm = s.ColumnString(6);
+      form.blocked_by_user = s.ColumnInt(7) != 0;
+      if (!form.url.is_valid() || form.signon_realm.empty()) {
+        continue;
+      }
+      if (!form.blocked_by_user) {
+        std::string value = s.ColumnBlobAsString(5);
+        std::optional<std::u16string> password = DecryptPassword(value, key);
+        std::ranges::fill(value, '\0');
+        if (!password || password->empty()) {
+          continue;
+        }
+        form.password_value = std::move(*password);
+      }
+      if (!seen.insert({form.signon_realm, form.url.spec(),
+                        form.username_value})
+               .second) {
+        continue;
+      }
+      bridge_->SetPasswordForm(form);
+      std::ranges::fill(form.password_value, u'\0');
+    }
+  }
+  if (key) {
+    std::ranges::fill(*key, '\0');
+  }
+}
+
+void ChromiumImporter::ImportSearchEngines() {
+  const base::FilePath file = CopyOf(L"Web Data");
+  if (file.empty()) {
+    return;
+  }
+  sql::Database db(kDatabaseTag);
+  if (!db.Open(file)) {
+    return;
+  }
+  // Only the ones the person added: the built-in engines (prepopulate_id
+  // above 0) are TizCat's own already, and "@bookmarks" and its kind are
+  // shortcuts every Chromium has.
+  sql::Statement s(db.GetUniqueStatement(
+      "SELECT short_name, keyword, url FROM keywords WHERE prepopulate_id = 0"));
+  if (!s.is_valid()) {
+    return;
+  }
+  std::vector<user_data_importer::SearchEngineInfo> engines;
+  while (s.Step() && !cancelled()) {
+    user_data_importer::SearchEngineInfo engine;
+    engine.display_name = s.ColumnString16(0);
+    engine.keyword = s.ColumnString16(1);
+    // Chromium writes the search words as {searchTerms}; the importer takes
+    // them as %s, as a person types the address. An address that needs any
+    // other of Chromium's {placeholders} is left out.
+    std::u16string url = s.ColumnString16(2);
+    base::ReplaceSubstringsAfterOffset(&url, 0, u"{searchTerms}", u"%s");
+    if (engine.keyword.empty() || engine.keyword.starts_with(u"@") ||
+        url.find(u'{') != std::u16string::npos ||
+        url.find(u"%s") == std::u16string::npos) {
+      continue;
+    }
+    engine.url = std::move(url);
+    engines.push_back(std::move(engine));
+  }
+  if (!engines.empty() && !cancelled()) {
+    bridge_->SetKeywords(engines, false);
+  }
+}
+
+void ChromiumImporter::ImportAutofillFormData() {
+  const base::FilePath file = CopyOf(L"Web Data");
+  if (file.empty()) {
+    return;
+  }
+  sql::Database db(kDatabaseTag);
+  if (!db.Open(file)) {
+    return;
+  }
+  // The words typed into web forms, offered again in the same fields. Their
+  // times are seconds since 1970.
+  sql::Statement s(db.GetUniqueStatement(
+      "SELECT name, value, count, date_created, date_last_used FROM autofill"));
+  if (!s.is_valid()) {
+    return;
+  }
+  std::vector<ImporterAutofillFormDataEntry> entries;
+  while (s.Step() && !cancelled()) {
+    ImporterAutofillFormDataEntry entry;
+    entry.name = s.ColumnString16(0);
+    entry.value = s.ColumnString16(1);
+    entry.times_used = s.ColumnInt(2);
+    entry.first_used = base::Time::FromTimeT(s.ColumnInt64(3));
+    entry.last_used = base::Time::FromTimeT(s.ColumnInt64(4));
+    if (!entry.name.empty() && !entry.value.empty()) {
+      entries.push_back(std::move(entry));
+    }
+  }
+  if (!entries.empty() && !cancelled()) {
+    bridge_->SetAutofillFormData(entries);
+  }
+}

+// Jib: whether a Chromium-style profile folder has anything to import.
+bool HasChromiumProfileData(const base::FilePath& profile) {
+  return base::PathExists(profile.Append(FILE_PATH_LITERAL("Bookmarks"))) ||
+         base::PathExists(profile.Append(FILE_PATH_LITERAL("History"))) ||
+         base::PathExists(profile.Append(FILE_PATH_LITERAL("Login Data")));
+}
+
+// Jib: the Chromium-based browsers installed for this Windows user, one
+// entry per profile with something in it, named as Brave names them: the
+// browser and the profile's name ("Google Chrome Work", "Microsoft Edge
+// Profile 1"), and Opera alone, as it has one profile. Imported by
+// ChromiumImporter.
+void DetectChromiumProfiles(
+    std::vector<user_data_importer::SourceProfile>* profiles) {
+  base::ScopedBlockingCall scoped_blocking_call(FROM_HERE,
+                                                base::BlockingType::MAY_BLOCK);
+  base::FilePath local;
+  base::FilePath roaming;
+  if (!base::PathService::Get(base::DIR_LOCAL_APP_DATA, &local) ||
+      !base::PathService::Get(base::DIR_ROAMING_APP_DATA, &roaming)) {
+    return;
+  }
+  // Each keeps a "User Data" folder: its Local State, and a folder per
+  // profile. Opera's is its one profile, shown without a name.
+  struct Browser {
+    const char16_t* name;
+    base::FilePath user_data;
+    bool one_profile = false;
+  };
+  const Browser browsers[] = {
+      {u"Google Chrome", local.Append(L"Google\\Chrome\\User Data")},
+      {u"Google Chrome Beta", local.Append(L"Google\\Chrome Beta\\User Data")},
+      {u"Google Chrome Dev", local.Append(L"Google\\Chrome Dev\\User Data")},
+      {u"Google Chrome Canary",
+       local.Append(L"Google\\Chrome SxS\\User Data")},
+      {u"Microsoft Edge", local.Append(L"Microsoft\\Edge\\User Data")},
+      {u"Brave", local.Append(L"BraveSoftware\\Brave-Browser\\User Data")},
+      {u"Opera", roaming.Append(L"Opera Software\\Opera Stable"), true},
+      {u"Opera GX", roaming.Append(L"Opera Software\\Opera GX Stable"), true},
+      {u"Vivaldi", local.Append(L"Vivaldi\\User Data")},
+      {u"Perplexity Comet", local.Append(L"Perplexity\\Comet\\User Data")},
+      {u"Yandex Browser", local.Append(L"Yandex\\YandexBrowser\\User Data")},
+      {u"Chromium", local.Append(L"Chromium\\User Data")},
+  };
+  for (const auto& [browser, user_data, one_profile] : browsers) {
+    if (!base::DirectoryExists(user_data)) {
+      continue;
+    }
+    // Its profiles, under the names the browser shows, from its Local State.
+    std::vector<std::pair<base::FilePath, std::u16string>> found;
+    std::string json;
+    if (base::ReadFileToString(user_data.Append(L"Local State"), &json)) {
+      std::optional<base::DictValue> state =
+          base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+      const base::DictValue* cache =
+          state ? state->FindDictByDottedPath("profile.info_cache") : nullptr;
+      if (cache) {
+        for (const auto [dir, info] : *cache) {
+          const base::FilePath path = user_data.AppendASCII(dir);
+          if (!HasChromiumProfileData(path)) {
+            continue;
+          }
+          const std::string* name =
+              info.is_dict() ? info.GetDict().FindString("name") : nullptr;
+          found.emplace_back(path, base::UTF8ToUTF16(name ? *name : dir));
+        }
+      }
+    }
+    // Opera lists no profiles: its one profile is in "Default", or (older
+    // versions) in the folder itself.
+    if (one_profile) {
+      found.clear();
+    }
+    if (found.empty()) {
+      for (const base::FilePath& path :
+           {user_data.Append(L"Default"), user_data}) {
+        if (HasChromiumProfileData(path)) {
+          found.emplace_back(path, std::u16string());
+          break;
+        }
+      }
+    }
+    for (const auto& [path, profile_name] : found) {
+      user_data_importer::SourceProfile source;
+      source.importer_name = browser;
+      if (!one_profile && !profile_name.empty()) {
+        source.importer_name += u" " + profile_name;
+      }
+      source.importer_type = user_data_importer::TYPE_CHROMIUM;
+      source.source_path = path;
+      source.app_path = user_data;  // Where its Local State is.
+      source.profile = profile_name;
+      source.services_supported = user_data_importer::HISTORY |
+                                  user_data_importer::FAVORITES |
+                                  user_data_importer::PASSWORDS |
+                                  user_data_importer::SEARCH_ENGINES |
+                                  user_data_importer::AUTOFILL_FORM_DATA;
+      profiles->push_back(source);
+    }
+  }
+}

+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_UTILITY_IMPORTER_CHROMIUM_IMPORTER_WIN_H_
+#define CHROME_UTILITY_IMPORTER_CHROMIUM_IMPORTER_WIN_H_
+
+#include <stdint.h>
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/scoped_temp_dir.h"
+#include "chrome/utility/importer/importer.h"
+#include "components/user_data_importer/common/imported_bookmark_entry.h"
+
+// Jib (TizCat): imports from another Chromium-based browser installed for
+// this Windows user (Google Chrome, Microsoft Edge, Brave, Opera, Vivaldi
+// and others, found by ImporterList): its bookmarks (with their sites'
+// icons), history, saved
+// passwords, search engines and autofill entries, read from copies of the
+// files in its profile folder (SourceProfile::source_path). Its saved
+// passwords are encrypted with a key kept in the "Local State" file in
+// SourceProfile::app_path.
+class ChromiumImporter : public Importer {
+ public:
+  ChromiumImporter();
+
+  ChromiumImporter(const ChromiumImporter&) = delete;
+  ChromiumImporter& operator=(const ChromiumImporter&) = delete;
+
+  // Importer:
+  void StartImport(const user_data_importer::SourceProfile& source_profile,
+                   uint16_t items,
+                   ImporterBridge* bridge) override;
+
+ private:
+  ~ChromiumImporter() override;
+
+  void ImportHistory();
+  void ImportBookmarks();
+  // The sites' icons for `bookmarks`, from the profile's "Favicons"
+  // database, so they show at once instead of a globe until each page is
+  // visited.
+  void ImportFavicons(
+      const std::vector<user_data_importer::ImportedBookmarkEntry>& bookmarks);
+  void ImportPasswords();
+  void ImportSearchEngines();
+  void ImportAutofillFormData();
+
+  // Copies the profile's file `name` (with its write-ahead log, if any) to a
+  // temporary folder, since the browser may have it open, and returns the
+  // copy's path; an empty path if there is no such file or it can't be read.
+  base::FilePath CopyOf(std::wstring_view name);
+
+  base::FilePath source_path_;
+  base::FilePath local_state_;
+  std::u16string browser_name_;
+  base::ScopedTempDir copies_;
+};
+
+#endif  // CHROME_UTILITY_IMPORTER_CHROMIUM_IMPORTER_WIN_H_

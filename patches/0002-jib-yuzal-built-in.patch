 #endif  // BUILDFLAG(ENABLE_HANGOUT_SERVICES_EXTENSION)
 
+#if !BUILDFLAG(IS_CHROMEOS)
+// Jib: Yuzal, Jib's assistant, is built in the way the PDF viewer is, but
+// her files sit beside the browser (<exe dir>\yuzal) instead of in its
+// resources, so she can change without Jib being recompiled. The key in her
+// manifest gives her the same ID wherever she is loaded from. Read off the
+// UI thread, like every other component extension loaded from a folder.
+void ComponentLoader::AddJibYuzal() {
+  base::FilePath exe_dir;
+  if (!base::PathService::Get(base::DIR_EXE, &exe_dir)) {
+    return;
+  }
+  const base::FilePath root = exe_dir.AppendASCII("yuzal");
+  GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](const base::FilePath& root) -> std::optional<base::DictValue> {
+            std::string error;
+            std::optional<base::DictValue> manifest =
+                file_util::LoadManifest(root, &error);
+            if (!manifest) {
+              LOG(WARNING) << "Jib: Yuzal not loaded from " << root << ": "
+                           << error;
+            }
+            return manifest;
+          },
+          root),
+      base::BindOnce(&ComponentLoader::FinishAddJibYuzal,
+                     weak_factory_.GetWeakPtr(), root));
+}
+
+void ComponentLoader::FinishAddJibYuzal(
+    const base::FilePath& root,
+    std::optional<base::DictValue> manifest) {
+  if (manifest) {
+    Add(std::move(*manifest), root, /*skip_allowlist=*/true);
+  }
+}
+#endif  // !BUILDFLAG(IS_CHROMEOS)

{
  "manifest_version": 3,
  "name": "JibWallet",
  "version": "0.1.0",
  "description": "TizCat's own wallet. For now a placeholder: its toolbar button and panel, before JibWallet itself is built.",
  "key": "",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "JibWallet",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "icons/icon_16.png",
      "24": "icons/icon_24.png",
      "32": "icons/icon_32.png"
    }
  },
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  }
}

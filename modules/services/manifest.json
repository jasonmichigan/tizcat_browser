{
  "manifest_version": 3,
  "name": "TizCat Services",
  "version": "0.2.0",
  "description": "TizCat's New Tab page, TizCat Rewards, and your TizCat account and sync in the browser.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "idle",
    "topSites",
    "search",
    "favicon",
    "bookmarks",
    "settingsPrivate",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.tizcat.com/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "TizCat Rewards",
    "default_popup": "rewards.html",
    "default_icon": {
      "16": "icons/icon_16.png",
      "24": "icons/icon_24.png",
      "32": "icons/icon_32.png"
    }
  },
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "externally_connectable": {
    "matches": ["https://account.tizcat.com/*"]
  }
}
